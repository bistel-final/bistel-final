MATCH (n) DETACH DELETE n;
MERGE (:Area {area_id:'Photo', area_name:'Photolithography'});
MERGE (:Area {area_id:'Etch', area_name:'Dry Etch'});
MERGE (r:Recipe {recipe_id:'RECIPE01', recipe_name:'CT-EXP-45NM'});
MERGE (r:Recipe {recipe_id:'RECIPE03', recipe_name:'CT-EXP-40NM'});
MERGE (r:Recipe {recipe_id:'RECIPE02', recipe_name:'CT-ETCH-45NM'});
MERGE (r:Recipe {recipe_id:'RECIPE04', recipe_name:'CT-ETCH-40NM'});
MERGE (rs:RecipeStep {recipe_id:'RECIPE01', recipe_step_no:1}) WITH rs MATCH (r:Recipe {recipe_id:'RECIPE01'}) MERGE (rs)-[:STEP_OF]->(r);
MERGE (rs:RecipeStep {recipe_id:'RECIPE01', recipe_step_no:2}) WITH rs MATCH (r:Recipe {recipe_id:'RECIPE01'}) MERGE (rs)-[:STEP_OF]->(r);
MERGE (rs:RecipeStep {recipe_id:'RECIPE03', recipe_step_no:1}) WITH rs MATCH (r:Recipe {recipe_id:'RECIPE03'}) MERGE (rs)-[:STEP_OF]->(r);
MERGE (rs:RecipeStep {recipe_id:'RECIPE03', recipe_step_no:2}) WITH rs MATCH (r:Recipe {recipe_id:'RECIPE03'}) MERGE (rs)-[:STEP_OF]->(r);
MERGE (rs:RecipeStep {recipe_id:'RECIPE02', recipe_step_no:1}) WITH rs MATCH (r:Recipe {recipe_id:'RECIPE02'}) MERGE (rs)-[:STEP_OF]->(r);
MERGE (rs:RecipeStep {recipe_id:'RECIPE02', recipe_step_no:2}) WITH rs MATCH (r:Recipe {recipe_id:'RECIPE02'}) MERGE (rs)-[:STEP_OF]->(r);
MERGE (rs:RecipeStep {recipe_id:'RECIPE04', recipe_step_no:1}) WITH rs MATCH (r:Recipe {recipe_id:'RECIPE04'}) MERGE (rs)-[:STEP_OF]->(r);
MERGE (rs:RecipeStep {recipe_id:'RECIPE04', recipe_step_no:2}) WITH rs MATCH (r:Recipe {recipe_id:'RECIPE04'}) MERGE (rs)-[:STEP_OF]->(r);
MERGE (s:ProcessStep {step_id:'CT-PHOTO', step_seq:1}) WITH s MATCH (a:Area {area_id:'Photo'}) MERGE (s)-[:IN_AREA]->(a);
MERGE (s:ProcessStep {step_id:'CT-ETCH', step_seq:2}) WITH s MATCH (a:Area {area_id:'Etch'}) MERGE (s)-[:IN_AREA]->(a);
MATCH (p:ProcessStep {step_id:'CT-PHOTO'}),(n:ProcessStep {step_id:'CT-ETCH'}) MERGE (p)-[:NEXT_STEP]->(n);
MERGE (m:EquipmentModel {model_code:'PH-9000', model_name:'Photo Scanner'}) WITH m MATCH (a:Area {area_id:'Photo'}) MERGE (m)-[:IN_AREA]->(a);
MERGE (m:EquipmentModel {model_code:'ET-7500', model_name:'Dry Etcher'}) WITH m MATCH (a:Area {area_id:'Etch'}) MERGE (m)-[:IN_AREA]->(a);
MERGE (e:Equipment {equipment_id:'EQP01'}) SET e.area='Photo', e.model_code='PH-9000' WITH e MATCH (m:EquipmentModel {model_code:'PH-9000'}) MERGE (e)-[:OF_MODEL]->(m);
MATCH (e:Equipment {equipment_id:'EQP01'}),(s:ProcessStep {step_id:'CT-PHOTO'}) MERGE (e)-[:PERFORMS]->(s);
MERGE (c:Chamber {chamber_id:'EQP01-PM1'}) WITH c MATCH (e:Equipment {equipment_id:'EQP01'}) MERGE (c)-[:PART_OF]->(e);
MERGE (c:Chamber {chamber_id:'EQP01-PM2'}) WITH c MATCH (e:Equipment {equipment_id:'EQP01'}) MERGE (c)-[:PART_OF]->(e);
MERGE (e:Equipment {equipment_id:'EQP02'}) SET e.area='Photo', e.model_code='PH-9000' WITH e MATCH (m:EquipmentModel {model_code:'PH-9000'}) MERGE (e)-[:OF_MODEL]->(m);
