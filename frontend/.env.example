# 로컬 개발 profile. 팀 compose production build는 Dockerfile에서 /api와 mock=false를
# build arg로 고정하므로 이 파일을 runtime env_file로 사용하지 않는다.
VITE_API_BASE_URL=http://localhost:8000
# mock 데이터 사용 여부 (기본 true, false로 설정 시 실제 API 호출)
VITE_USE_MOCK=true

# 도메인별 오버라이드 — 미설정 시 전역 VITE_USE_MOCK 을 따른다.
# 백엔드 detection·agent 라우터 구현 전까지 이 두 도메인만 mock 으로 남기고
# 구현된 영역(analytics·documents)은 실서버로 보낼 때 사용:
#   VITE_USE_MOCK=false + 아래 두 줄 true
# TODO(api): A/C 라우터 구현 완료 시 오버라이드 제거
# VITE_USE_MOCK_DETECTION=true
# VITE_USE_MOCK_AGENT=true

# 팀 compose production build 정본:
# VITE_API_BASE_URL=/api
# VITE_USE_MOCK=false
# VITE_USE_MOCK_DETECTION=false
# VITE_USE_MOCK_AGENT=false
