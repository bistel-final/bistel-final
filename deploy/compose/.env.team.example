# V5-CM-4.5 팀 compose 전용 입력이다.
# 이 파일을 .env.team 으로 복사하고 실제 공용 값과 secret을 채운다.
# root .env를 서비스에 통째로 전달하지 않는다.

TEAM_IMAGE_TAG=v5-0123456

# 외부 PostgreSQL. 시연 때 인프라·앱 example host는 팀장 PC 사설 IP로 바꾼다.
POSTGRES_HOST=db.example.invalid
POSTGRES_PORT=53001
POSTGRES_DB=kosa_agent
APP_DB_USER=kosa_app
APP_DB_PASSWORD=
READONLY_USER=kosa_readonly
READONLY_PASSWORD=

# 외부 Neo4j
NEO4J_URI=bolt://neo4j.example.invalid:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# 외부 n8n. 컨테이너에서 localhost는 공용 n8n을 뜻하지 않으므로 금지한다.
N8N_WEBHOOK_URL=http://n8n.example.invalid:5678/webhook/fdc-notify-email
N8N_WF3_URL=http://n8n.example.invalid:5678/webhook/fdc-mes-hold
N8N_BASE_URL=http://n8n.example.invalid:5678
N8N_WEBHOOK_SECRET=
N8N_WEBHOOK_TIMEOUT_SEC=30
DELIVERY_UNKNOWN_AFTER_SEC=600
AGENT_EMAIL_RECIPIENTS=approved-test-inbox@example.com

# 브라우저 origin과 공용 n8n callback 기준 주소
CORS_ORIGINS=http://app.example.invalid:8080,http://app.example.invalid:53000
BACKEND_BASE_URL=http://app.example.invalid:8080/api

# OpenAI-compatible endpoint. 공용 배포에서 컨테이너 자신의 localhost는 금지한다.
LLM_PROVIDER=openai-compatible
LLM_MODEL_MAIN=team-approved-model
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1500
LLM_TIMEOUT_SEC=60
LLM_API_KEY=
LLM_BASE_URL=http://llm.example.invalid:11434/v1

# 고정 RAG artifact. host 절대경로는 image에 포함하지 않고 read-only mount한다.
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_MODEL_REVISION=5617a9f61b028005a4858fdac845db406aefb181
EMBEDDING_DIM=1024
RAG_MODEL_CACHE_DIR=/absolute/path/to/backend/model-cache/bge-m3

# 팀 Kafka. advertised host는 위 Backend/CORS host와 같은 팀장 PC 사설 IP이며,
# 공용 n8n 컨테이너에서도 해석 가능해야 한다. 외부 listener port는 53005로 고정한다.
KAFKA_ADVERTISED_HOST=kafka.example.invalid
KAFKA_BROKER_USER=kosa_broker
KAFKA_BROKER_PASSWORD=
KAFKA_CLIENT_USER=kosa_fdc_client
KAFKA_CLIENT_PASSWORD=
