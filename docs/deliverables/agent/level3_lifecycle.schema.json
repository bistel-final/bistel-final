        "title": "Final Status",
        "type": "string"
      },
      "golden_flow_sha256": {
        "anyOf": [
          {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Golden Flow Sha256"
      },
      "issued_by": {
        "enum": [
          "PUBLISH",
          "RECOVER"
        ],
        "title": "Issued By",
        "type": "string"
      },
      "lifecycle_claim_publish": {
        "$ref": "#/$defs/Component"
      },
      "lifecycle_claim_resume_workload": {
        "$ref": "#/$defs/Component"
      },
      "lifecycle_outcome_resume_workload": {
        "$ref": "#/$defs/Component"
      },
      "primary_failure_code": {
        "anyOf": [
          {
            "enum": [
              "STAGE2_STEP_FAILED",
              "WORKLOAD_ABORTED",
              "PUBLISH_PRECONDITION_FAILED",
              "ARTIFACT_PUBLISH_FAILED",
              "STALE_CLAIM_RECOVERED",
