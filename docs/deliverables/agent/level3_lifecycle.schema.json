      "fault_5class_sha256": {
        "anyOf": [
          {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Fault 5Class Sha256"
      },
      "final_status": {
        "enum": [
          "PASS",
          "FAIL"
