# =====================================================================
# 환경변수 예시
# 실제 비밀번호와 외부 IP는 .env에만 입력한다.
# .env는 절대 Git에 커밋하지 않는다.
# =====================================================================

# ---------------------------------------------------------------------
# PostgreSQL (pgvector)
# ---------------------------------------------------------------------
POSTGRES_USER=kosa
POSTGRES_PASSWORD=change_me
POSTGRES_DB=kosa
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# 공용 DB base schema bootstrap 전용 설정. 앱 DSN과 분리하며 runner는 아래 5개만 읽는다.
# 허용 host fingerprint = sha256(lowercase(host) + ":" + decimal port)
# 실제 host·계정·비밀번호·지문은 .env에만 입력한다.
POSTGRES_BOOTSTRAP_HOST=bootstrap-db.example.invalid
POSTGRES_BOOTSTRAP_PORT=5432
POSTGRES_BOOTSTRAP_USER=bootstrap_ddl
POSTGRES_BOOTSTRAP_PASSWORD=
POSTGRES_BOOTSTRAP_ALLOWED_HOST_SHA256=CHANGE_ME_TO_64_CHAR_LOWERCASE_SHA256

# Text2SQL 전용 읽기 계정
READONLY_USER=kosa_readonly
READONLY_PASSWORD=change_me

# ---------------------------------------------------------------------
# 최소권한 계정과 목적별 연결 (시스템설계서 13.1·14.1)
#   Backend 일반 pool은 APP_DATABASE_URL 또는 APP_DB_USER/PASSWORD만 사용한다.
#   POSTGRES_USER/PASSWORD로의 fallback은 허용하지 않는다.
#   운영은 kosa_agent, 골드 평가는 kosa_text2sql 로 목적을 분리한다.
# ---------------------------------------------------------------------
APP_DB_USER=kosa_app
APP_DB_PASSWORD=
EVALUATION_DB_USER=kosa_evaluation
EVALUATION_DB_PASSWORD=
QUERY_LOGGER_USER=kosa_query_logger
QUERY_LOGGER_PASSWORD=
# n8n은 signed HTTP callback만 사용한다. 아래 role은 NOLOGIN·DB 권한 0이며
# direct DB password를 설정하지 않는다.
N8N_DELIVERY_DB_USER=kosa_n8n_delivery

APP_DATABASE_URL=postgresql+psycopg://kosa_app:change_me@localhost:5432/kosa_agent
TEXT2SQL_DATABASE_URL=postgresql+psycopg://kosa_readonly:change_me@localhost:5432/kosa_agent
TEXT2SQL_EVAL_DATABASE_URL=postgresql+psycopg://kosa_readonly:change_me@localhost:5432/kosa_text2sql
TEXT2SQL_EVAL_LOG_DATABASE_URL=postgresql+psycopg://kosa_query_logger:change_me@localhost:5432/kosa_text2sql

TEXT2SQL_STATEMENT_TIMEOUT_MS=5000
TEXT2SQL_MAX_ROWS=500

# ---------------------------------------------------------------------
# Neo4j
# ---------------------------------------------------------------------
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_URI=bolt://localhost:7687

# 공용 Neo4j graph bootstrap 전용 설정. 앱 연결 설정과 분리하며 loader는
# 아래 5개만 읽는다. 허용 target fingerprint는
# sha256(lowercase(scheme) + "://" + lowercase(host) + ":" + port + "/" + database)다.
# backup root는 저장소 밖의 절대경로를 사용한다.
NEO4J_BOOTSTRAP_URI=bolt://neo4j-bootstrap.example.invalid:7687
NEO4J_BOOTSTRAP_USER=neo4j_bootstrap
NEO4J_BOOTSTRAP_PASSWORD=
NEO4J_BOOTSTRAP_ALLOWED_TARGET_SHA256=CHANGE_ME_TO_64_CHAR_LOWERCASE_SHA256
NEO4J_BOOTSTRAP_BACKUP_ROOT=/path/outside/repository/neo4j-backups
# V5-CM-2.6 공용 PostgreSQL 전환 전 base 9 backup을 두는 곳. 저장소 밖 절대경로만
# 허용하고 경로에 symlink가 있으면 거부한다. 실제 dump 파일은 Git에 올리지 않는다.
POSTGRES_BOOTSTRAP_BACKUP_ROOT=/path/outside/repository/postgres-backups

# V5-CM-2.6 공용 3 DB 전환(base 9 DELETE·ALTER·COPY). 아래 5개는 backup CLI와
# transition CLI가 **공통으로** 읽는 endpoint 계약이고, ARCHIVE 1개는 transition apply
# 전용이다(총 6개). ALLOWED_HOST_SHA256은
# sha256(lowercase(host) + ":" + decimal_port)이며, 값이 맞지 않으면 connection을
# 열기 전에 ENDPOINT_NOT_ALLOWED로 끝난다 — 잘못된 .env가 다른 PostgreSQL의 base 9를
# 지우는 것을 막는 유일한 guard다. 계산은 postgres_transition.endpoint_fingerprint()로 한다.
POSTGRES_TRANSITION_HOST=transition-db.example.invalid
POSTGRES_TRANSITION_PORT=5432
POSTGRES_TRANSITION_USER=transition_owner
POSTGRES_TRANSITION_PASSWORD=
POSTGRES_TRANSITION_ALLOWED_HOST_SHA256=CHANGE_ME_TO_64_CHAR_LOWERCASE_SHA256
# 여기까지가 공통 5개. 아래는 조건부·전용 값이다.
# Windows에서만 필요하다. backup root의 ACL을 사람이 확인했다는 명시 입력이며, 값은
# 그 실행의 change_ref와 exact여야 한다(다른 실행의 확인 값은 거부한다). POSIX는
# 설정하지 않는다 — 대신 root 소유자와 mode 0700을 코드가 직접 실측한다.
# POSTGRES_BACKUP_ROOT_ACL_REVIEWED=GH-000
# 최종 project.zip 경로. transition CLI의 기본 배선이 여기서 profile을 읽는다.
POSTGRES_TRANSITION_ARCHIVE=/path/outside/repository/project.zip

# ---------------------------------------------------------------------
# n8n (조치 전송 자동화)
# ---------------------------------------------------------------------
N8N_USER=kosa
N8N_PASSWORD=change_me
N8N_PORT=5678
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_URL=http://localhost:5678/webhook/equipment-alert

# Backend 와 n8n workflow 가 같은 값을 공유한다. 비면 기동 준비 실패로 처리한다.
N8N_WEBHOOK_SECRET=
N8N_WEBHOOK_TIMEOUT_SEC=10

# ---------------------------------------------------------------------
# 기존 멘토 Streamlit 설정
# React 전환 후 사용하지 않지만 원본 호환을 위해 일단 유지
# ---------------------------------------------------------------------
APP_PORT=8501

# ---------------------------------------------------------------------
# LLM / 임베딩
# ---------------------------------------------------------------------
LLM_PROVIDER=ollama

LLM_MODEL_MAIN=qwen2.5:7b-instruct
LLM_MODEL_DEV=qwen2.5:3b-instruct
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1500
LLM_TIMEOUT_SEC=60

# 로컬 Ollama
OLLAMA_BASE_URL=http://localhost:11434

# 외부 API 사용 시 실제 키는 .env에만 입력
LLM_API_KEY=
LLM_BASE_URL=

# 이미 적재된 임베딩 설정 — 특별한 이유 없이 변경하지 않는다
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_API_KEY=

# ---------------------------------------------------------------------
# 에이전트 동작 설정
# ---------------------------------------------------------------------
# 1 = 고정 순서
# 2 = 조건 분기·재시도
# 3 = 완전 자율 ReAct
AGENT_AUTONOMY_LEVEL=2

AGENT_MAX_TOOL_CALLS=8
AGENT_MAX_RETRY=3

HITL_REQUIRED_SEVERITY=HIGH

# 모델 score는 manifest의 versioned threshold만 사용한다. 환경변수로 threshold를
# 덮어쓰지 않으며, C의 판정보조 정책이 구현되기 전까지 gate는 기본 비활성화한다.
MODEL_SIGNAL_ENABLED=false

# classify_fault 구조화 출력 실패 시 교정 요청 횟수. Tool 재시도와 합산하지 않는다.
CLASSIFICATION_OUTPUT_RETRY=1

# Tool 제한시간
TOOL_DB_TIMEOUT_SEC=5
TOOL_EMBEDDING_TIMEOUT_SEC=15

# 고착 판정 임계. 자동 스케줄러 없이 운영자가 복구 스크립트를 실행한다.
ACTION_SENDING_STALE_SEC=60
AGENT_RUN_STALE_SEC=900

# ---------------------------------------------------------------------
# 배포 산출물 경로 (Git 제외 대상)
# ---------------------------------------------------------------------
ANOMALY_MODEL_PATH=backend/artifacts/isolation_forest.joblib
EMBEDDING_MODEL_PATH=backend/model-cache/bge-m3
EMBEDDING_MODEL_REVISION=5617a9f61b028005a4858fdac845db406aefb181

# 배포패키지 절대경로. 최종 Compose 의 bootstrap 마운트에 사용한다.
MENTOR_PACKAGE_DIR=

# ---------------------------------------------------------------------
# 기타
# ---------------------------------------------------------------------
TZ=Asia/Seoul
LOG_LEVEL=INFO

# ---------------------------------------------------------------------
# FastAPI — React 전환 추가
# ---------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000

# Compose 는 /api, 호스트 Uvicorn 개발은 빈 값
API_ROOT_PATH=

# 여러 주소는 쉼표로 구분
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------
# Frontend
#   frontend/.env 에도 같은 키가 필요하다.
# ---------------------------------------------------------------------
VITE_API_BASE_URL=/api
