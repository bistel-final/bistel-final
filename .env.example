# =====================================================================
# 환경변수 예시
# 실제 비밀번호와 외부 IP는 .env에만 입력한다.
# .env는 절대 Git에 커밋하지 않는다.
# =====================================================================

# ---------------------------------------------------------------------
# PostgreSQL (pgvector)
# ---------------------------------------------------------------------
POSTGRES_USER=kosa
POSTGRES_PASSWORD=change_me
POSTGRES_DB=kosa
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Text2SQL 전용 읽기 계정
READONLY_USER=kosa_readonly
READONLY_PASSWORD=change_me

# ---------------------------------------------------------------------
# Neo4j
# ---------------------------------------------------------------------
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_URI=bolt://localhost:7687

# ---------------------------------------------------------------------
# n8n (조치 전송 자동화)
# ---------------------------------------------------------------------
N8N_USER=kosa
N8N_PASSWORD=change_me
N8N_PORT=5678
N8N_WEBHOOK_URL=http://localhost:5678/webhook/equipment-alert

# ---------------------------------------------------------------------
# 기존 멘토 Streamlit 설정
# React 전환 후 사용하지 않지만 원본 호환을 위해 일단 유지
# ---------------------------------------------------------------------
APP_PORT=8501

# ---------------------------------------------------------------------
# LLM / 임베딩
# ---------------------------------------------------------------------
LLM_PROVIDER=ollama

LLM_MODEL_MAIN=qwen2.5:7b-instruct
LLM_MODEL_DEV=qwen2.5:3b-instruct
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1500
LLM_TIMEOUT_SEC=60

# 로컬 Ollama
OLLAMA_BASE_URL=http://localhost:11434

# 외부 API 사용 시 실제 키는 .env에만 입력
LLM_API_KEY=
LLM_BASE_URL=

# 이미 적재된 임베딩 설정 — 특별한 이유 없이 변경하지 않는다
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_API_KEY=

# ---------------------------------------------------------------------
# 에이전트 동작 설정
# ---------------------------------------------------------------------
# 1 = 고정 순서
# 2 = 조건 분기·재시도
# 3 = 완전 자율 ReAct
AGENT_AUTONOMY_LEVEL=2

AGENT_MAX_TOOL_CALLS=8
AGENT_MAX_RETRY=3

HITL_REQUIRED_SEVERITY=HIGH

ANOMALY_SCORE_THRESHOLD=0.62
SEVERITY_HIGH_THRESHOLD=0.80

# ---------------------------------------------------------------------
# 기타
# ---------------------------------------------------------------------
TZ=Asia/Seoul
LOG_LEVEL=INFO

# ---------------------------------------------------------------------
# FastAPI — React 전환 추가
# ---------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000

# 여러 주소는 쉼표로 구분
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173