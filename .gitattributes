# =====================================================================
#  줄바꿈 정규화
#  macOS·Windows 를 함께 쓰므로 기본 텍스트는 저장소·작업 트리 모두 LF 로 통일한다.
#  Windows 전용 스크립트만 예외로 CRLF 를 유지한다(아래 참고).
#  통일하지 않으면 내용을 바꾸지 않은 파일이 CRLF 차이만으로 diff 에 뜬다.
# =====================================================================
* text=auto eol=lf

# ---------------------------------------------------------------------
# LF 를 반드시 유지해야 하는 것
#   Docker·컨테이너 안에서 실행되므로 CRLF 면 shebang 이 깨져 실행되지 않는다.
# ---------------------------------------------------------------------
*.sh        text eol=lf
Dockerfile  text eol=lf
*.sql       text eol=lf
*.cypher    text eol=lf
*.csv       text eol=lf
.env.example text eol=lf

# ---------------------------------------------------------------------
# Windows 전용 스크립트만 CRLF
# ---------------------------------------------------------------------
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# ---------------------------------------------------------------------
# 바이너리 — 줄바꿈 변환·diff 대상에서 제외한다
# ---------------------------------------------------------------------
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.pdf    binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.joblib binary
*.zip    binary
*.xlsx   binary
*.docx   binary
*.pptx   binary

# ---------------------------------------------------------------------
# 생성 파일 표시
#   GitHub 에서 기본 접힘 처리되어 diff 노이즈가 줄어든다.
#   -diff 는 쓰지 않는다. 의존성이 바뀌었을 때 리뷰어가 내용을 확인해야 한다.
# ---------------------------------------------------------------------
package-lock.json linguist-generated=true
