# Environment
.env
.env.*
# 편집기·Finder 가 만드는 사본(".env 2", ".env copy")은 위 두 규칙에 걸리지 않는다.
# 공개 저장소라 한 번의 `git add -A` 로 자격증명이 나간다.
.env[ ]*
!.env.example
!deploy/compose/.env.team.example
.venv/
venv/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# ML model artifacts
# joblib 본체와 임베딩 캐시는 제외하되, backend/artifacts/*.json manifest는
# 재현성 근거이므로 커밋한다 (시스템설계서 13.5).
*.joblib
backend/model-cache/

# Local files
logs/
data/
deploy/compose/trail/

# IDE / OS
.vscode/
.idea/
.DS_Store
.claude/settings.local.json

# 개인 검토용 산출물 — 정리 후 docs/ 로 옮긴다
output/

# CM-4.7 reset 증적 — 로컬 전용, 커밋 금지 (runbook 정책)
infra/bootstrap/reports/
